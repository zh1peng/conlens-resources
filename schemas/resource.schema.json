{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zh1peng/conlens-resources/schemas/resource.schema.json",
  "title": "ConLens resource manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_id",
    "resource_version",
    "kind",
    "title",
    "description",
    "atlases",
    "license",
    "checksums"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "resource_id": {"type": "string", "minLength": 1},
    "resource_version": {"type": "string", "minLength": 1},
    "kind": {"enum": ["node_features", "edge_features", "edge_sets"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "atlases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "features_file": {"type": "string"},
    "license": {"type": "string", "minLength": 1},
    "citations": {"type": "string"},
    "checksums": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
